# Environment variable template for codegrapher
# Copy this file to .env and fill in your values

# LLM Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# Default LLM provider (openai, anthropic, google, groq, mistral, cohere, custom)
LLM_PROVIDER=openai

# Default model name
LLM_MODEL=

# Custom LLM endpoint (for custom provider)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
